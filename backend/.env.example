# Settings reference only. main.py loads the repository-root .env.
# For local setup, copy the root .env.example to the root .env instead.
MAX_UPLOAD_MB=10
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:8000

# Optional AI Assistant configuration (Iqra Shaheen - 01):
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ASSISTANT_MODE=auto

# Database/authentication is not connected to this FastAPI application.
# DATABASE_URL and JWT_SECRET belong to Saud's separate Node service.
# See the root README before configuring that unfinished integration.

# PostgreSQL example: postgresql+psycopg://username:password@localhost:5432/decisionai
# If unset, local development uses SQLite at backend/data/decisionai.db
DATABASE_URL=
# Set a random secret of at least 32 characters in production
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
